@{
}

@model Movie

<h1>Add a Movie</h1>

<form asp-action="AddMovie" method="post">
    <label>Title:</label>
    <input asp-for="Title" required /><br>

    <label>Category</label>
    <select asp-for="CategoryId">
        <option value="">Select a Category</option>
        @foreach (Categories c in ViewBag.Categories)
        {
            <option value="@c.CategoryId">@c.CategoryName</option>
        }
    </select><br />

    <label>Year:</label>
    <input asp-for="Year" required /><br>

    <label>Director:</label>
    <input asp-for="Director" required /><br>

    <label>Edited:</label>
    <input asp-for="Edited" required /><br>

    <label>Rating:</label>
    <select asp-for="Rating">
        <option>G</option>
        <option>PG</option>
        <option>PG-13</option>
        <option>R</option>
    </select><br>

    <label>Copied To Plex:</label>
    <input asp-for="CopiedToPlex" required /><br>

    <label>Lent To:</label>
    <input asp-for="LentTo" /><br>

    <label>Notes (max 25 characters):</label>
    <input asp-for="Notes" maxlength="25" /><br>

    <button type="submit">Submit</button>
</form>