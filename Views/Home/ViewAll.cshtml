@{
}

@model List<Movie>

<table class="table table-bordered">
    <thead class='fw-bold'>
        <tr>
            <td>Title</td>
            <td>Category</td>
            <td>Director</td>
            <td>Release Year</td>
            <td>Rating</td>
            <td>Edited</td>
            <td>Lent to</td>
            <td>Notes</td>
        </tr>
    </thead>
    
    @foreach (var x in Model)
    {
    <tbody>
        <tr>
            <td>@x.Title</td>
            <td>@x.Category</td>
            <td>@x.Director</td>
            <td>@x.Year</td>
            <td>@x.Rating</td>
            <td>@x.LentTo</td>
            <td>@x.Notes</td>
        </tr>
    </tbody>
    }
</table>

@* public int MovieId { get; set; } // Primary Key *@
